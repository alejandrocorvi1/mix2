rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global fallback
    match /app_config/{document} {
      allow read, write: if true;
    }

    match /sessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /presence/{deviceId} {
        allow read, write: if true;
      }

      match /files/{fileId} {
        allow read, write: if true;
      }

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }
  }
}

